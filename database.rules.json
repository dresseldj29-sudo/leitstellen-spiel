{
  "rules": {

    ".read": "auth != null",

    ".write": "auth != null",


    "users": {

      "$uid": {

        ".read":
          "auth != null",

        ".write":
          "auth != null && auth.uid === $uid"

      }

    },


    "servers": {

      "$serverId": {


        "players": {

          "$uid": {

            ".read":
              "auth != null",

            ".write":
              "auth != null && auth.uid === $uid"

          }

        },


        "vehicles": {

          "$vehicleId": {

            ".read":
              "auth != null",

            ".write":
              "auth != null",

            "crew": {

              "$uid": {

                ".read":
                  "auth != null",

                ".write":
                  "auth != null && auth.uid === $uid"

              }

            }

          }

        },


        "radio": {

          "$channel": {

            ".read":
              "auth != null",

            ".write":
              "auth != null"

          }

        },


        "voiceSignals": {

          "$uid": {

            ".read":
              "auth != null && auth.uid === $uid",

            ".write":
              "auth != null"

          }

        }

      }

    }

  }
}
