rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benutzer müssen eingeloggt sein
    function signedIn() {
      return request.auth != null;
    }

    // Benutzerprofile
    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    // Server
    match /servers/{serverId} {
      allow read, write: if signedIn();
    }

    // Spieler eines Servers
    match /servers/{serverId}/players/{playerId} {
      allow read, write: if signedIn();
    }

    // Fahrzeuge
    match /servers/{serverId}/vehicles/{vehicleId} {
      allow read, write: if signedIn();
    }

    // Einsätze
    match /servers/{serverId}/missions/{missionId} {
      allow read, write: if signedIn();
    }

    // Funknachrichten
    match /servers/{serverId}/radio/{messageId} {
      allow read, write: if signedIn();
    }

    // Einsatzberichte
    match /servers/{serverId}/reports/{reportId} {
      allow read, write: if signedIn();
    }

    // Allgemeine Serverdaten
    match /servers/{serverId}/data/{dataId} {
      allow read, write: if signedIn();
    }
  }
}
