rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /* =================================================
           BENUTZER
        ================================================= */

        match /users/{userId} {

            allow read:
                if request.auth != null
                && request.auth.uid == userId;

            allow create:
                if request.auth != null
                && request.auth.uid == userId;

            allow update:
                if request.auth != null
                && request.auth.uid == userId;

            allow delete:
                if request.auth != null
                && request.auth.uid == userId;

        }


        /* =================================================
           SERVER
        ================================================= */

        match /servers/{serverId} {

            allow read:
                if request.auth != null;

            allow create:
                if request.auth != null;

            allow update:
                if request.auth != null;

            allow delete:
                if request.auth != null;


            /* =============================================
               SERVER SPIELER
            ============================================= */

            match /players/{playerId} {

                allow read:
                    if request.auth != null;

                allow create:
                    if request.auth != null;

                allow update:
                    if request.auth != null
                    && (
                        request.auth.uid ==
                        playerId
                        ||
                        resource.data.uid ==
                        request.auth.uid
                    );

                allow delete:
                    if request.auth != null
                    && request.auth.uid ==
                       playerId;

            }


            /* =============================================
               FAHRZEUGE
            ============================================= */

            match /vehicles/{vehicleId} {

                allow read:
                    if request.auth != null;

                allow create:
                    if request.auth != null;

                allow update:
                    if request.auth != null;

                allow delete:
                    if request.auth != null;

            }


            /* =============================================
               EINSÄTZE
            ============================================= */

            match /operations/{operationId} {

                allow read:
                    if request.auth != null;

                allow create:
                    if request.auth != null;

                allow update:
                    if request.auth != null;

                allow delete:
                    if request.auth != null;

            }


            /* =============================================
               FUNK
            ============================================= */

            match /radio/{messageId} {

                allow read:
                    if request.auth != null;

                allow create:
                    if request.auth != null;

                allow update:
                    if request.auth != null;

                allow delete:
                    if request.auth != null;

            }

        }

    }
}
